# Ignore Bazel build directories
bazel-bin/
bazel-genfiles/
bazel-out/

# Ignore Bazel test directories
bazel-testlogs/

# Ignore the Bazel cache
bazel-cache/

# Ignore Bazel user cache
bazel-user/

# Ignore Bazel output base
bazel-*

# Ignore editor swap files
*~

# Ignore backup files
*.bak
*.swp

# Ignore compiled object files and libraries
*.o
*.a
*.so
*.dylib

# Ignore CMake cache and build directories if you are using CMake as well
CMakeCache.txt
CMakeFiles/
cmake-build-debug/
cmake-build-release/

# Ignore Visual Studio files
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore Xcode files
*.mode1v3
*.mode2v3
*.pbxuser
*.perspectivev3
*.xcuserdatad/

# Ignore JetBrains IDE files
.idea/
*.iml

# Ignore Eclipse IDE files
.metadata/
.settings/
.classpath
.project

# Ignore temporary files
*.tmp

# Ignore logs
*.log

# Ignore build artifacts not generated by Bazel
build/
build-*/

# Ignore the .git directory itself
.git/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore buildifier
buildifier.*

# Ignore C++ compile cache
compile_commands.json
compile_flags.txt

# Ignore Bazel external dependencies
external/

# IDE specific files
.vscode/
.idea/

coverage_reports

#=====================================
# Mo Compiler Specific Files
#=====================================

# Generated assembly files
*.s
!**/*_template.s      # Keep template files if any

# Generated LLVM IR files
*.ll
*.bc

# Generated object files (additional to general ones above)
*.obj

# Generated executable files in examples
examples/simple
examples/helloworld
examples/test*
examples/debug*

# Test outputs and temporary files
test_program*
*_test.out
*_debug.out
*.dump
*.trace

# Compiler debug output
*.ast
*.ir
*.tokens
*.parse

# Generated output directories
*_output/
riscv_output/
arm64_output/
docker/output/

# Runtime files
core
core.*

# Profiling data
*.prof
gmon.out

# Memory debugging
*.valgrind
*.asan
*.msan

# Coverage files
*.gcov
*.gcda
*.gcno
lcov.info
